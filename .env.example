# Environment Settings (development, testing, production)
APP_ENV=development

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=cyberscout.log

# Database Configuration
DB_NAME=cyberscout.db

# GitHub API Token (Optional: Increases rate limits from 60 req/hr to 5,000 req/hr)
# Create a local .env file in the project root and add your Personal Access Token
GITHUB_TOKEN=your_github_personal_access_token

# Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=app-password-here
RECIPIENT_EMAIL=user@example.com
