# Environment Settings (development, testing, production)
APP_ENV=development

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=cyberscout.log

# Database Configuration
# Primary Production / PostgreSQL Connection URL (e.g., Supabase, Render PostgreSQL, Neon)
# If DATABASE_URL is present, CyberScout AI connects to PostgreSQL via SQLAlchemy.
# If DATABASE_URL is absent, CyberScout AI automatically falls back to local SQLite.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/cyberscout
DB_NAME=cyberscout.db

# GitHub API Token (Optional: Increases rate limits from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=

# Email Notification Provider Selection
# Options: 'smtp' (Gmail/Standard SMTP for local dev), 'brevo' (Production REST API over HTTPS), 'resend', 'sendgrid', 'console'
EMAIL_PROVIDER=smtp

# Production Cloud Email Provider (Brevo REST API - Recommended for Render)
BREVO_API_KEY=
EMAIL_FROM=cyberscout-alerts@example.com
EMAIL_TO=recipient@example.com

# Local Development SMTP Settings (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECIPIENT_EMAIL=

# Daily Scheduled Email Delivery Settings (Phase 12.3)
EMAIL_ENABLED=true
REPORT_TIME=00:00
TIMEZONE=Asia/Kolkata
REPORT_FREQUENCY=daily
SEND_EMPTY_REPORT=false
