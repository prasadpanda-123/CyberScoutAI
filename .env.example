# Environment Settings (development, testing, production)
APP_ENV=development

# Application Secret Key (Mandatory in production: min 32 bytes cryptographically secure hex/urlsafe)
SECRET_KEY=replace-with-cryptographically-secure-64-character-hex-secret
# Canonical public HTTPS origin used to construct password-reset links.
PUBLIC_APP_URL=

# Initial Admin Password (unused; production setup is authorized by INITIAL_ADMIN_SETUP_TOKEN)
# CYBERSCOUT_INITIAL_ADMIN_PASSWORD=ComplexAdminPass2026!
# Required in production before using /setup; set a unique high-entropy value and remove it after creating the first administrator.
INITIAL_ADMIN_SETUP_TOKEN=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=cyberscout.log

# Database Configuration (Mandatory PostgreSQL)
# Set DATABASE_URL in this local file or in the deployment secret store.
# Use the exact provider URI, URL-encode reserved characters in credentials, and require TLS where supported.
# Supabase example shape: postgresql://<user>:<encoded-password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=

# GitHub API Token (Optional: Increases rate limits from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=

# Email Notification Provider Selection
# Options: 'smtp' (Gmail/Standard SMTP for local dev), 'brevo' (Production REST API over HTTPS), 'resend', 'sendgrid', 'console'
EMAIL_PROVIDER=smtp

# Production Cloud Email Provider (Brevo REST API - Recommended for Render)
BREVO_API_KEY=
EMAIL_FROM=cyberscout-alerts@example.com
EMAIL_TO=recipient@example.com

# Local Development SMTP Settings (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECIPIENT_EMAIL=

# Daily Scheduled Email Delivery Settings (Phase 12.3)
EMAIL_ENABLED=true
REPORT_TIME=00:00
TIMEZONE=Asia/Kolkata
REPORT_FREQUENCY=daily
SEND_EMPTY_REPORT=false

# External Scheduler Trigger Secret (Google Apps Script -> CyberScout AI)
CYBERSCOUT_SCHEDULER_SECRET=replace-with-long-random-secret

# Discovery & Content Extraction Providers (Phase B & Phase C)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Production defaults to disabled. Enable only after configuring provider-side
# redirect and egress protections for private and link-local destinations.
FIRECRAWL_ENABLED=false
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_RETRIES=3
FIRECRAWL_MAX_PAGES_PER_RUN=25
FIRECRAWL_MAX_RESPONSE_SIZE=2097152
FIRECRAWL_RATE_LIMIT=10

# AI Opportunity Classification Providers (Phase D)
GROQ_API_KEY=
GEMINI_API_KEY=
AI_CLASSIFICATION_ENABLED=true
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_TOKENS=4096
AI_MAX_CLASSIFICATIONS_PER_RUN=25
AI_CLASSIFICATION_PROMPT_VERSION=v1.0

# Deterministic Free-Only Verification (Phase E)
FREE_ONLY_ENABLED=true
FREE_ONLY_RULE_VERSION=v1.0
FREE_ONLY_MAX_CANDIDATES_PER_RUN=50
FREE_ONLY_STRICT_ZERO_TRUST=true

# Controlled Production Promotion & Daily Intelligence Report (Phase F)
PROMOTION_DRY_RUN=true
PROMOTION_ENABLED=false
DAILY_REPORT_ENABLED=false
DAILY_REPORT_TIMEZONE=Asia/Kolkata
EMAIL_DELIVERY_ENABLED=false
REPORT_MAX_OPPORTUNITIES=50
DAILY_REPORT_RECIPIENT=alerts@cyberscout.ai
