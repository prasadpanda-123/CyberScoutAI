# Environment Settings (development, testing, production)
APP_ENV=development

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=cyberscout.log

# Database Configuration
DB_NAME=cyberscout.db

# GitHub API Token (Optional: Increases rate limits from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=

# Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECIPIENT_EMAIL=

# Daily Scheduled Email Delivery Settings (Phase 12.3)
EMAIL_ENABLED=true
REPORT_TIME=00:00
TIMEZONE=Asia/Kolkata
REPORT_FREQUENCY=daily
SEND_EMPTY_REPORT=false
